{
  "name": "@vhyxchart/core",
  "version": "0.2.1",
  "description": "VhyxChart engine — parse Markdown-friendly diagram text, lay it out, and render animated SVG. Zero dependencies, works in Node and the browser.",
  "keywords": [
    "vhyxchart",
    "vhyxara",
    "diagram",
    "flowchart",
    "sequence-diagram",
    "animation",
    "svg"
  ],
  "license": "MIT",
  "homepage": "https://github.com/vhyxara/vhyxchart#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vhyxara/vhyxchart.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/vhyxara/vhyxchart/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./vhyxchart.global.js": "./dist/vhyxchart.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle-browser.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.0"
  }
}
