{
  "name": "@vhyxchart/cli",
  "version": "0.1.0-alpha",
  "description": "VhyxChart command line: render diagrams and Markdown to animated SVG, lint diagrams in CI, export interactive HTML.",
  "license": "MIT",
  "type": "module",
  "bin": { "vhyxchart": "./dist/bin.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/bin.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vhyxchart/core": "workspace:*"
  }
}
